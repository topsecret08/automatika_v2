CONFIG_IDF_TARGET="esp32s3"
CONFIG_FREERTOS_UNICORE=n
CONFIG_FREERTOS_NUMBER_OF_CORES=2
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_IDLE_HOOK=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_USE_PERF_MONITOR=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_MSC_ENABLED=y
# OTA только по HTTPS: сертификат сервера проверяется через CA bundle.
# Для локальной отладки можно временно вернуть y (см. main/config.h →
# OTA_ALLOW_PLAIN_HTTP), но в production это запрещено.
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=n
CONFIG_FATFS_LFN_HEAP=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_SQLITE3_PROFILE_STANDARD=y
CONFIG_ESP_SQLITE3_THREADSAFE=y
CONFIG_ESP_SQLITE3_SYNCHRONOUS_NORMAL=y
# WebSocket API для web_api.c
CONFIG_HTTPD_WS_SUPPORT=y

# --- OTA с автоматическим откатом (anti-brick) ------------------------
# Загрузчик держит новый образ в ESP_OTA_IMG_PENDING_VERIFY, пока
# ota_manager не подтвердит его по результату health-check.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_APP_ANTI_ROLLBACK=n

# --- Lua (espressif/lua) ---------------------------------------------
# Крупные объекты Lua — в PSRAM; стек VM не должен давить внутреннюю RAM.
CONFIG_LUA_USE_PSRAM=y
CONFIG_LUA_MAXSTACK=10000

# --- littlefs (joltwallet/littlefs) ----------------------------------
CONFIG_LITTLEFS_MAX_PARTITIONS=2
CONFIG_LITTLEFS_PAGE_SIZE=256
CONFIG_LITTLEFS_OBJ_NAME_LEN=64
