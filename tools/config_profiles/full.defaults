# Полная конфигурация: все исследовательские модули включены.
# Проверяется в CI как вторая точка матрицы.
CONFIG_VERIFY_ENABLE=y
CONFIG_ADAPTIVE_PID_ENABLE=y
CONFIG_LOOP_VERIFY_ENABLE=y
CONFIG_ACTUATOR_READBACK_ENABLE=y
CONFIG_SAFETY_RELAY_ENABLE=y
CONFIG_EQ_LOCK_ENABLE=y
CONFIG_VLE_ENABLE=y
CONFIG_PUMP_PCHIP_ENABLE=y
CONFIG_ZONE_CONSENSUS_ENABLE=y
CONFIG_I2C_STEPPER_ENABLE=y
