# Минимальная конфигурация: только базовый контур.
# Проверяется в CI, чтобы новые модули не ломали сборку при выключении.
CONFIG_VERIFY_ENABLE=n
CONFIG_ADAPTIVE_PID_ENABLE=n
CONFIG_LOOP_VERIFY_ENABLE=n
CONFIG_ACTUATOR_READBACK_ENABLE=n
CONFIG_SAFETY_RELAY_ENABLE=n
CONFIG_EQ_LOCK_ENABLE=n
CONFIG_VLE_ENABLE=n
CONFIG_PUMP_PCHIP_ENABLE=n
CONFIG_ZONE_CONSENSUS_ENABLE=n
CONFIG_I2C_STEPPER_ENABLE=n
