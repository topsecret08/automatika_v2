menu "Verification / shadow mode"

    config VERIFY_ENABLE
        bool "Enable shadow mode, staged flags and SQLite verification"
        default y
        help
            Включает verify_config, shadow, verify_db, safety_gate и
            REST /api/verify/*. Для релизной сборки можно выключить:
            сложные алгоритмы не смогут применяться, останется только
            критическая логика.

    config ADAPTIVE_PID_ENABLE
        bool "Enable multi-layer adaptive PID"
        default y
        help
            L1 gain scheduling, L2 RLS/IMC, L3 degradation rollback.
            При выключении ctrl_pid использует обычный PID/AutoPID.

endmenu

menu "Automatika V0.7 beta"

    config LOOP_VERIFY_ENABLE
        bool "Active loop verification"
        default y
        help
            Сквозная проверка датчик → программа → исполнитель.

    config ACTUATOR_READBACK_ENABLE
        bool "Actuator readback"
        default y
        help
            GPIO/CURRENT обратная связь исполнителей.

    config SAFETY_RELAY_ENABLE
        bool "Fail-safe NC safety relay"
        default y
        help
            Heartbeat-реле, размыкающее цепь при зависании.

    config EQ_LOCK_ENABLE
        bool "EQ_LOCK module"
        default y

    config VLE_ENABLE
        bool "VLE ethanol-water thresholds"
        default n

    config PUMP_PCHIP_ENABLE
        bool "PCHIP pump calibration"
        default n

    config ZONE_CONSENSUS_ENABLE
        bool "Zone sensor consensus"
        default n

    config I2C_STEPPER_ENABLE
        bool "I2C stepper driver (doser and stirrer)"
        default n
        help
            Включает обмен с внешним драйвером шагового двигателя по
            протоколу core/stepper_proto.h. При выключении дозатор и
            мешалка работают через GPIO/реле.

endmenu


config HMI_EXTERNAL_UI
    bool "External HMI panel on CAN (no local LVGL)"
    default n

menu "Automatika HMI CAN/TWAI (external panel)"

    config HMI_CAN_ENABLE
        bool "Enable CAN (TWAI) slave interface for HMI panel"
        default y
        help
            Контроллер отвечает на POLL/CMD/GET_CONFIG/PING от внешней панели по CAN.
            Панель инициирует запросы. Safety и E-STOP остаются здесь.

    config HMI_CAN_TX_GPIO
        int "CAN TX GPIO (to TJA1051 TXD)"
        default 17
        help
            После CONFIG_HMI_EXTERNAL_UI=y выводы свободны. Рекомендуется GPIO17 (бывший UART TX)
            для CAN TX. Не трогать 19/20 (USB), 43/44, 22–25, 26–37.

    config HMI_CAN_RX_GPIO
        int "CAN RX GPIO (from TJA1051 RXD)"
        default 18
        help
            Рекомендуется GPIO18 (бывший UART RX) для CAN RX.

    config HMI_CAN_BITRATE_KBPS
        int "CAN bitrate (kbps)"
        default 500
        range 100 1000
        help
            500 kbps — рекомендуемый баланс скорости и надёжности. Поддерживаются
            профили таймингов 250/500/1000 kbps; другие значения округляются к 500.

endmenu
