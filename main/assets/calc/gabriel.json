{
  "title": "Метод Габриэля",
  "inputs": [
    {"n":"vol","label":"Объём браги","min":5,"max":100,"def":20,"unit":"л"},
    {"n":"abv","label":"Крепость","min":5,"max":20,"def":10,"unit":"%"}
  ],
  "outputs": [
    {"n":"t1","label":"T1 (крепкая)","formula":"vol*(0.3+abv/100*0.25)","unit":"л"},
    {"n":"t2","label":"T2 (слабая)","formula":"vol*(1-(0.3+abv/100*0.25))","unit":"л"},
    {"n":"dilute","label":"Разбавить","formula":"vol*(0.3+abv/100*0.25)*abv/28","unit":"л"},
    {"n":"out","label":"Выход (65%)","formula":"vol*(0.3+abv/100*0.25)*abv/100*0.85/0.65","unit":"л"},
    {"n":"time","label":"Прогноз времени","formula":"vol*(0.3+abv/100*0.25)*8+(vol*(1-(0.3+abv/100*0.25)))*5","unit":"мин"}
  ]
}